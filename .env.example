# Copy to .env and fill in whatever you have. Missing providers are skipped.
# The chain is tried in this order; each is a legitimate free tier.

# https://aistudio.google.com/apikey      (generous free tier — start here)
GEMINI_API_KEY=

# https://console.groq.com/keys           (fast, free tier)
GROQ_API_KEY=

# https://cloud.cerebras.ai               (free tier)
CEREBRAS_API_KEY=

# https://openrouter.ai/keys              (use :free models)
OPENROUTER_API_KEY=

# --- Supabase (Phase: gallery). Anon key is safe in the browser; ---
# --- the service_role key is NOT. Never ship service_role client-side. ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
